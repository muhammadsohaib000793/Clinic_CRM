# =============================================================================
#  CRM & Unified Messaging Platform — Environment Variables (TEMPLATE)
# =============================================================================
#  Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#  Values are SECRETS (§13 security note): treat tokens like passwords.
#  Every variable is read at runtime; missing Meta creds -> that channel runs
#  in DRY-RUN mode (logs the send instead of calling Meta) so you can test.
# =============================================================================

# -----------------------------------------------------------------------------
#  App infrastructure (needed to run locally — not in doc §11, but required)
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Prisma connection string. Matches the docker-compose Postgres service.
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm?schema=public
# Secret used to sign CRM login JWTs (invent a long random string)
JWT_SECRET=
# Admin account, created/updated on every seed (env is the source of truth).
# CHANGE THE PASSWORD before deploying. All other agents are made in the Admin UI.
ADMIN_EMAIL=admin@weevolveit.mx
ADMIN_PASSWORD=Admin123!321
# Set to "true" to ALSO seed demo agents + sample conversations (dev only).
# Leave empty in production so only the admin + doctors + templates are seeded.
SEED_DEMO=
# Public base URL of the backend (used only for logging / webhook display)
PUBLIC_BASE_URL=http://localhost:3000
# Where the React client runs (CORS allowlist)
CLIENT_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
#  Messaging safety switches (§9A ban-prevention)
# -----------------------------------------------------------------------------
# Force dry-run for ALL channels (true = never actually call Meta). If unset,
# each channel auto-dry-runs when its own token is missing.
MESSAGING_DRY_RUN=
# Comma-separated WhatsApp test recipients (wa_id / phone, digits only).
# In the 90-day test phase Meta allows only <=5 verified recipients.
# Leave blank to skip the allowlist guard (NOT recommended in test phase).
WHATSAPP_TEST_RECIPIENTS=
# Instagram automated-DM safety cap (rolling per hour). Doc §9A: ~200/hr.
# Keep a margin below 200.
INSTAGRAM_HOURLY_DM_CAP=180
# Default red-flag threshold in minutes (configurable later in Admin UI)
REDFLAG_THRESHOLD_MINUTES=15

# -----------------------------------------------------------------------------
#  WhatsApp Cloud API  (§11) — SECRET values
# -----------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=      # from Kainos handoff
WHATSAPP_WABA_ID=              # WhatsApp Business Account ID
WHATSAPP_ACCESS_TOKEN=         # permanent System User token — SECRET
GRAPH_API_VERSION=v21.0

# -----------------------------------------------------------------------------
#  Meta App (Messenger / Instagram / webhooks)  (§11) — SECRET values
# -----------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=              # SECRET — also verifies webhook signatures
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=         # SECRET (also used for Instagram via Method A)
IG_BUSINESS_ACCOUNT_ID=

# -----------------------------------------------------------------------------
#  Webhook  (§11)
# -----------------------------------------------------------------------------
# Dev invents this; it MUST match the value Truji registers in Meta.
WEBHOOK_VERIFY_TOKEN=weevolveit_dev_2026

# -----------------------------------------------------------------------------
#  AI Agent (offline coverage) — Anthropic Claude with mock fallback
# -----------------------------------------------------------------------------
# anthropic | mock   (falls back to mock automatically if key is missing)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=            # optional — mock replies used when absent
AI_MODEL=claude-sonnet-5

# -----------------------------------------------------------------------------
#  Optional notification channels — used by appointment reminders and email
#  campaigns. Leave BLANK to run those channels in dry-run (logged, not sent);
#  WhatsApp reminders work without these and always go through sendGuard (§9A).
# -----------------------------------------------------------------------------
RESEND_API_KEY=               # optional — email reminders/campaigns
EMAIL_FROM=                   # e.g. "WeEvolveit Clinic <clinic@kainos.mx>"

# SMS via Twilio (optional — reminders only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=            # SECRET
TWILIO_FROM=
